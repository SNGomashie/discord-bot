# Copy to .env and fill in. Never commit .env.
# ENVIRONMENT must be "dev" for Ralph to run (see scripts/ralph/ralph.sh).
ENVIRONMENT=dev
DISCORD_TOKEN=
# Guild (server) the bot syncs slash commands to instantly. Required in dev.
GUILD_ID=
# Optional channel IDs used by features/smoke tests
TEST_CHANNEL_ID=
# Longest video (in seconds) /download will accept. Default 3600 (1 hour).
MAX_DURATION_SECONDS=3600
# Leetify public API key for /scoreboard and /profile (leetify.com/app/developer). Optional.
LEETIFY_API_KEY=
# Reserved for automatic CS2 match posts (channel ID), which are not implemented yet.
# Setting it has no effect today, but a malformed value still stops the bot at startup.
CS2_CHANNEL_ID=
# Reserved for automatic CS2 match posts (poll interval in seconds, default 300), not implemented yet.
# Setting it has no effect today, but a malformed value still stops the bot at startup.
CS2_POLL_SECONDS=300
# Directory for persistent data such as cs2.sqlite3. Default "data".
DATA_DIR=data
