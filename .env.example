# Copy to .env and fill in. Never commit .env.
# ENVIRONMENT must be "dev" for Ralph to run (see scripts/ralph/ralph.sh).
ENVIRONMENT=dev
DISCORD_TOKEN=
# Guild (server) the bot syncs slash commands to instantly. Required in dev.
GUILD_ID=
# Longest video (in seconds) /download will accept. Default 3600 (1 hour).
MAX_DURATION_SECONDS=3600
# Leetify public API key for /scoreboard and /profile (leetify.com/app/developer). Optional.
LEETIFY_API_KEY=
# Channel for automatic CS2 match posts (new matches of linked players). Unset = no auto-posts.
CS2_CHANNEL_ID=
# How often (seconds) to check Leetify for new matches when CS2_CHANNEL_ID is set. Default 300.
CS2_POLL_SECONDS=300
# Directory for persistent data such as cs2.sqlite3. Default "data".
DATA_DIR=data
# Channel for the automatic monthly activity report. Unset = no monthly post.
# ACTIVITY_CHANNEL_ID=123456789012345678
# Time zone (IANA name) for activity month boundaries. Default UTC.
# ACTIVITY_TIMEZONE=Europe/Amsterdam
# User ID of the Toasty bot; set = track ;pokemon catches. Needs the Message Content
# intent enabled in the Developer Portal. Unset = no Toasty tracking, no privileged intent.
# TOASTY_BOT_ID=123456789012345678
