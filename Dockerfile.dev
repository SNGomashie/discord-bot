# Dev/Ralph sandbox. Debian 13 (trixie) + Python 3.13 to match the prod LXC.
FROM python:3.13-slim-trixie

RUN apt-get update \
 && apt-get install -y --no-install-recommends git jq curl ca-certificates tmux less ffmpeg \
 && rm -rf /var/lib/apt/lists/* \
 && git config --system --add safe.directory /workspace

COPY --from=ghcr.io/astral-sh/uv:0.13.0 /uv /uvx /usr/local/bin/

# Non-root user: Claude Code refuses --dangerously-skip-permissions as root.
ARG UID=1000
ARG GID=1000
RUN groupadd -g ${GID} dev && useradd -m -u ${UID} -g ${GID} -s /bin/bash dev
USER dev
ENV HOME=/home/dev \
    PATH=/home/dev/.local/bin:$PATH \
    UV_PROJECT_ENVIRONMENT=/home/dev/.venv \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    CLAUDE_CONFIG_DIR=/home/dev/.claude-config

# Claude Code CLI (native installer)
RUN curl -fsSL https://claude.ai/install.sh | bash

WORKDIR /workspace
CMD ["bash"]
